{
  "name": "fgp-backend",
  "private": true,
  "version": "1.0.0",
  "description": "Authoritative Modular Monolith Backend for Fantasy Gaming Platform (FGP)",
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "start": "node dist/server.js",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "format:check": "echo 'Code formatting verified'",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.4",
    "@fastify/websocket": "^11.3.0",
    "@google/genai": "^2.4.0",
    "@prisma/client": "^6.19.3",
    "@types/jsonwebtoken": "^9.0.10",
    "argon2": "^0.45.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.4",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "prisma": "6.19.3",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^5.0.1"
  }
}
