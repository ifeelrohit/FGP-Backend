# ==============================================================================
# FGP-Backend Environment Configuration (Phase 03)
# Note: In accordance with platform security, never commit actual secrets.
# ==============================================================================

# Server Environment
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Database Configuration (PostgreSQL)
POSTGRES_USER=fgp_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=fgp_db
DATABASE_URL="postgresql://fgp_user:your_secure_postgres_password_here@localhost:5432/fgp_db?schema=public"

# Authentication & JWT Secrets
JWT_ACCESS_SECRET="fgp_development_jwt_access_secret_key_change_in_production_min_32_chars"
JWT_REFRESH_SECRET="fgp_development_jwt_refresh_secret_key_change_in_production_min_32_chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Configuration (comma-separated origins or *)
CORS_ORIGIN="*"

# Observability & Logging
LOG_LEVEL="info"

# Repository Mode (Optional: strictly for test environments, forbidden in production)
# REPOSITORY_MODE=memory

# Default Demo Virtual Credits for New Players
DEFAULT_DEMO_CREDITS=10000
